NODE_ENV=development
PORT=4100

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/cafe_management?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# App
FRONTEND_URL=http://localhost:4000

# Voice ordering assistant (QR menu)
# claude-cli = use the local Claude Code CLI (your Claude subscription), falling back to the rules bot
# rules      = built-in rule-based bot only (no AI)
VOICE_AI_ENGINE=claude-cli
# Token from `claude setup-token` (only needed if this machine isn't already logged in to `claude`)
CLAUDE_CODE_OAUTH_TOKEN=
# haiku is fastest for voice (~3-4s); sonnet/opus are smarter but slower
VOICE_CLAUDE_MODEL=haiku
VOICE_CLAUDE_TIMEOUT_MS=20000
VOICE_CLAUDE_MAX_CONCURRENT=3
VOICE_RATE_LIMIT_PER_MIN=20
